layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "GERD is a chronic 
digestive disorder 
where stomach acid 
frequently flows back 
(refluxes) into the 
esophagus (food pipe), 
irritating its lining due to
 a weak or poorly closing 
lower esophageal sphincter
 (LES) muscle, leading to 
symptoms like chest pain,
cough, and sore throat"
horizontal_alignment = 1

