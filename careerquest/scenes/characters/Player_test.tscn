theme_override_font_sizes/font_size = 11
text = "Diabetes is a chronic 
condition where your 
blood sugar (glucose) 
levels are too high
 because your body 
either doesn't make 
enough insulin or can't 
use it effectively,
preventing sugar from 
entering cells for energy, 
leading to potential 
damage to the heart, 
eyes, kidneys, and 
nerves over time"
horizontal_alignment = 1

