theme_override_font_sizes/font_size = 11
text = "COPD is a lung 
condition that 
makes breathing 
difficult, involving 
inflamed, damaged 
airways and air sacs
(alveoli) that block 
airflow, leading to 
symptoms like  cough, 
shortness of breath,
 and chest tightness,
 primarily caused 
by long-term irritant
 exposure  like smoking"
horizontal_alignment = 1

